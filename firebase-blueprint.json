{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "طلب حجز معاملة مرورية داخل محافظة نينوى حصراً",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "bookingNumber": { "type": "string", "pattern": "^TR-NIN-2026-\\d{6}$" },
        "fullName": { "type": "string", "minLength": 6, "maxLength": 120 },
        "surname": { "type": "string", "minLength": 2, "maxLength": 50 },
        "phone": { "type": "string", "pattern": "^(07|\\+9647)\\d{8,9}$" },
        "governorate": { "type": "string", "enum": ["Nineveh"] },
        "serviceId": { "type": "string", "maxLength": 64 },
        "serviceName": { "type": "string", "maxLength": 120 },
        "price": { "type": "number" },
        "paymentStatus": {
          "type": "string",
          "enum": ["UNPAID", "PENDING_VERIFICATION", "VERIFIED", "REJECTED"]
        },
        "bookingStatus": {
          "type": "string",
          "enum": ["PENDING_PAYMENT", "PAYMENT_REVIEW", "CONFIRMED", "REJECTED", "COMPLETED"]
        },
        "paymentProofUrl": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string" },
        "verifiedAt": { "type": "string" },
        "verifiedBy": { "type": "string", "maxLength": 100 },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "adminNotes": { "type": "string", "maxLength": 500 },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["bookingNumber", "fullName", "surname", "phone", "governorate", "serviceId", "serviceName", "price", "paymentStatus", "bookingStatus"]
    },
    "Service": {
      "title": "Service",
      "description": "الخدمات والرسوم المرورية المعتمدة لمحافظة نينوى",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "price": { "type": "number" },
        "active": { "type": "boolean" },
        "sortOrder": { "type": "number" }
      },
      "required": ["id", "name", "price", "active"]
    },
    "Settings": {
      "title": "Settings",
      "description": "إعدادات منصة الحجز المروري وبيانات الدفع والتواصل",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "maxLength": 100 },
        "whatsappNumber": { "type": "string", "maxLength": 20 },
        "supportPhone": { "type": "string", "maxLength": 20 },
        "allowBookings": { "type": "boolean" },
        "paymentNotice": { "type": "string", "maxLength": 500 }
      },
      "required": ["siteName", "whatsappNumber", "allowBookings"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": { "$ref": "Booking" },
      "description": "سجلات الحجوزات المرورية لمواطني نينوى"
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "Service" },
      "description": "قائمة الخدمات والرسوم الرسمية"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "Settings" },
      "description": "إعدادات النظام العامة وبيانات الدفع"
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "Settings" },
      "description": "سجل المشرفين المعتمدين لإدارة النظام"
    }
  }
}
